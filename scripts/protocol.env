# Single source of truth for the E0-E5 training protocol (SPEC §5).
# Every arm sources this file; only EXPERIMENT (and MHLA groups) may differ.
# Do NOT edit after the first real (non-smoke) run has started.

# Paths (TC2 home layout; override in the environment if needed)
REPO_DIR="${REPO_DIR:-$HOME/EfficientnetVit-MHLA}"
PYTHON="${PYTHON:-$HOME/envs/effvit/bin/python}"
DATA_ROOT="${DATA_ROOT:-$HOME/datasets/cityscapes}"
RUNS_ROOT="${RUNS_ROOT:-$HOME/runs/protocol_v1}"
INIT_CHECKPOINT="${INIT_CHECKPOINT:-$HOME/ckpt/efficientvit_b1_r224.pt}"
OFFICIAL_SEG_CHECKPOINT="${OFFICIAL_SEG_CHECKPOINT:-$HOME/ckpt/efficientvit_seg_b1_cityscapes.pt}"

# Model
MODEL="efficientvit-seg-b1-cityscapes"
MHLA_NUM_GROUPS=4

# Initialization: ImageNet B1 backbone only; no-multi-scale arms inherit the base-head projection slice
INIT_SCOPE="backbone"
INHERIT_SLICED_PROJ=1

# Recipe (teammate's cityscapes_v2: colour jitter, cat-max-ratio crops, native-mask val, MHLA safeguards,
# backbone LR x0.1 — fresh/new tensors keep full LR)
RECIPE="cityscapes_v2"
CROP_HEIGHT=512
CROP_WIDTH=1024
BATCH_SIZE=8            # per forward pass (BatchNorm sees 8 images)
GRAD_ACCUM_STEPS=2      # global batch 16
LR=6.0e-4
WEIGHT_DECAY=0.01
WARMUP_STEPS=500
MIN_LR_RATIO=0.01
GRAD_CLIP=1.0
MAX_STEPS=40000         # set from the TC2 throughput probe: min(40000, 12 GPU-hours), rounded down to 1000
SEED=0

# Monitoring
EVAL_INTERVAL=2000
VAL_MAX_SAMPLES=0       # 0 = all 500 Cityscapes val images (512x1024 input, native masks)
SAVE_INTERVAL=500
LOG_INTERVAL=20
WORKERS=8
